# ==========================================
# Karma Scrims Environment Variables Template
# Copy these to your Render Web Service Environment Variables
# ==========================================

# Database Connection (SQLite default or PostgreSQL connection string)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL URL on Render:
# DATABASE_URL="postgresql://user:password@dpg-xxxx-a.render.com/karma_scrims_db?sslmode=require"

# JWT Secret Key for User Authentication
JWT_SECRET="karma-scrims-esports-super-secret-jwt-key-2026"

# Secret Key for Admin Panel Session Security
ADMIN_SESSION_SECRET="karma-scrims-admin-panel-secret-key-2026-secure"

# Public Web Application URL (Set to your Render app URL when live, e.g. https://karma-scrims.onrender.com)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
